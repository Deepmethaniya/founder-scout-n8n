    {
      "parameters": {
        "query": "={{ $json.person_name.replace(/^(Dr\\.|Prof\\.)\\s*/i, '') }} {{ $json.company }} LinkedIn",
        "options": {
          "max_results": 5,
          "include_domains": [
            "linkedin.com"
          ]
        }
      },
      "type": "@tavily/n8n-nodes-tavily.tavily",
      "typeVersion": 2.1,
      "position": [
        3744,
        160
      ],
      "id": "c4b902af-b6f7-4bde-b0a2-589ff3c3a6d7",
      "name": "SearchLinkedIn"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Pick a LinkedIn profile only from real search results and check it with fixed rules.\n// Verified = name + company + founder/CEO role all match, and no second profile fits equally well.\nconst base = $('HasPerson').item.json;\nconst results = $input.item.json.results || [];\n\nconst norm = (s) => (s || '').toLowerCase()\n  .replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss')\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n\nconst nameTokens = norm(base.person_name)\n  .replace(/\\b(dr|prof|med|rer|nat|phil|ing)\\b\\.?/g, ' ')\n  .split(/[^a-z]+/).filter(t => t.length >= 2);\nconst first = nameTokens[0] || '';\nconst last = nameTokens[nameTokens.length - 1] || '';\nconst companyTokens = norm(base.company).split(/[^a-z0-9]+/).filter(t => t.length >= 3);\nconst domainCore = norm((base.website || '').replace(/^https?:\\/\\//, '').split('/')[0]).split('.')[0];\nconst roleWords = /(founder|co-founder|cofounder|ceo|managing director|geschaeftsfuehrer|gruender|chief executive)/;\n\nconst candidates = [];\nfor (const r of results) {\n  const m = (r.url || '').match(/linkedin\\.com\\/in\\/([^/?#]+)/i);\n  if (!m) continue; // only profile URLs – never posts or company pages\n  let handle = m[1];\n  try { handle = decodeURIComponent(handle); } catch (e) {}\n  const url = 'https://www.linkedin.com/in/' + handle + '/';\n  const text = norm((r.title || '') + ' ' + (r.content || ''));\n  const slug = norm(decodeURIComponent(m[1]));\n  const nameOk = first && last\n    && (text.includes(first) || slug.includes(first))\n    && (text.includes(last) || slug.includes(last));\n  if (!nameOk) continue;\n  const companyOk = companyTokens.some(t => text.includes(t)) || (domainCore.length >= 3 && text.includes(domainCore));\n  const roleOk = roleWords.test(text);\n  if (!candidates.some(c => c.url === url)) {\n    candidates.push({ url, score: (companyOk ? 2 : 0) + (roleOk ? 1 : 0), companyOk, roleOk });\n  }\n}\ncandidates.sort((a, b) => b.score - a.score);\n\nlet linkedin = '';\nlet verified = 'Unverified';\nlet note = '';\n\nif (candidates.length === 0) {\n  note = 'No LinkedIn profile with this name found in search results.';\n} else {\n  const best = candidates[0];\n  const ties = candidates.filter(c => c.score === best.score && c.url !== best.url);\n  linkedin = best.url;\n  if (ties.length > 0) {\n    note = 'Several profiles fit this name: ' + [best.url, ...ties.map(t => t.url)].join(' , ');\n  } else if (best.companyOk && best.roleOk) {\n    verified = 'Verified';\n    note = 'Name, company and founder/CEO role all match the LinkedIn result.';\n  } else {\n    note = 'Name matches' + (best.companyOk ? ', company matches' : ', company not confirmed')\n      + (best.roleOk ? ', role matches' : ', role not confirmed') + '.';\n  }\n}\n\nreturn { json: { ...base, linkedin_url: linkedin, verified, check_note: note } };"
      },
