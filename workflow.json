      ],
      "id": "24049917-f824-44ef-b85c-97650ef41bc1",
      "name": "AI model (OpenRouter)"
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"people\": [\n    {\n      \"name\": \"Anna Beispiel\",\n      \"role\": \"Co-founder & CEO\",\n      \"source_url\": \"https://example.com/impressum\",\n      \"evidence\": \"Geschäftsführer: Anna Beispiel\"\n    }\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        3080,
        392
      ],
      "id": "fc28e3ba-93b7-4f98-b5cf-310522b44293",
      "name": "Founder list format"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Company: {{ $json.company }}\nWebsite: {{ $json.website }}\n\nTEXT:\n{{ $json.research_text }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You extract people from the TEXT only. Never use outside knowledge and never guess.\n\nList only people the TEXT explicitly names as founder, co-founder, CEO, or managing director (Geschäftsführer/Geschäftsführerin) of the company given. Ignore investors, advisors, employees, journalists and people at other companies.\n\nFor each person return:\n- name: exactly as written in the TEXT\n- role: as written (translate Geschäftsführer/Geschäftsführerin to \"Managing Director\")\n- source_url: the URL of the block where the name appears\n- evidence: the exact words from the TEXT that show the role (max 15 words)\n\nIf the TEXT names nobody, return an empty list. An empty list is a correct answer."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        2944,
        160
      ],
      "id": "f81f4985-bf10-4ebc-a425-aa7c45dd7206",
      "name": "ExtractFounder",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "maxTries": 3
    },
    {
      "parameters": {
        "jsCode": "// One item per founder, with the company data attached. Duplicate names are removed.\nconst bases = $('CollectResearch').all();\nconst out = [];\n\n$input.all().forEach((item, i) => {\n  const base = { ...bases[i].json };\n  delete base.research_text;\n  const people = (item.json.output && item.json.output.people) || [];\n  const seen = new Set();\n\n  for (const p of people) {\n    const name = (p.name || '').trim();\n    const key = name.toLowerCase().replace(/\\s+/g, ' ');\n    if (!name || seen.has(key)) continue;\n    seen.add(key);\n    out.push({ json: { ...base, person_name: name, role: p.role || '', person_source: p.source_url || '', evidence: p.evidence || '', status: 'Founder found' } });\n  }\n\n  if (seen.size === 0) {\n    out.push({ json: { ...base, person_name: '', role: '', person_source: '', evidence: '', status: 'No founder found in Impressum or news' } });\n  }\n});\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3296,
