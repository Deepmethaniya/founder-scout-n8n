      "id": "ea9adac5-1efc-4072-90e1-683a2be02ed6",
      "name": "FindWebsite"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Pick the official website for each company from the Tavily results.\n// Only accepts a domain that contains the company name, so nothing is guessed.\nconst base = $('Limit').item.json;\nconst company = (base.company || '').toLowerCase();\nconst slug = company.replace(/[^a-z0-9]/g, '');\nconst firstWord = company.split(/[^a-z0-9]+/).find(w => w.length >= 4) || slug;\nconst results = $input.item.json.results || [];\n\nconst matches = (host) => {\n  const h = host.toLowerCase().replace(/^www\\./, '');\n  const label = h.split('.')[0].replace(/[^a-z0-9]/g, '');\n  const whole = h.replace(/[^a-z0-9]/g, '');\n  const nameInHost = whole.includes(slug) || label.includes(firstWord);\n  const notTooLong = label.length <= slug.length + 6; // rejects e.g. 'sparxityconsulting'\n  return nameInHost && notTooLong;\n};\n\nlet website = '';\nlet websiteSource = 'not found';\nlet foundedYear = base.founded || '';\n\n// 1) Company profile pages often state \"Website: www.example.com\" and \"Founded: 2024\"\nfor (const r of results) {\n  const text = r.content || '';\n  const site = text.match(/Website:\\s*(?:https?:\\/\\/)?(?:www\\.)?([a-z0-9-]+(?:\\.[a-z0-9-]+)+)/i);\n  if (site && matches(site[1])) {\n    website = 'https://' + site[1].toLowerCase();\n    websiteSource = 'company profile';\n    const founded = text.match(/Founded:\\s*(\\d{4})/i);\n    if (founded && !foundedYear) foundedYear = founded[1];\n    break;\n  }\n}\n\n// 2) Otherwise: a search result whose own domain matches the company name\nif (!website) {\n  for (const r of results) {\n    let host = '';\n    try { host = new URL(r.url).hostname; } catch (e) { continue; }\n    if (matches(host)) {\n      website = 'https://' + host.toLowerCase().replace(/^www\\./, '');\n      websiteSource = 'search result domain';\n      break;\n    }\n  }\n}\n\n// 3) Use the founding year to settle unknown stages\nlet stageNote = base.stage_note;\nif (stageNote === 'Unknown – check by hand' && foundedYear) {\n  stageNote = Number(foundedYear) >= 2021\n    ? 'Other (founded ' + foundedYear + ', likely early stage)'\n    : 'Other (founded ' + foundedYear + ', likely later stage – check)';\n}\n\nreturn {\n  json: {\n    ...base,\n    founded: foundedYear,\n    stage_note: stageNote,\n    website,\n    website_source: websiteSource,\n  },\n};"
      },
