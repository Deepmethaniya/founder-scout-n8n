      "name": "SearchNews"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Combine Impressum + news text into one block for the AI to read.\nconst base = $('PickWebsite').item.json;\nconst impressum = $('SearchImpressum').item.json.results || [];\nconst news = $input.item.json.results || [];\n\nconst format = (list, label) =>\n  list.map(r => `[${label}] ${r.url}\\n${(r.raw_content || r.content || '').slice(0, 2500)}`).join('\\n\\n---\\n\\n');\n\nconst researchText = (format(impressum, 'IMPRESSUM') + '\\n\\n---\\n\\n' + format(news, 'NEWS')).slice(0, 9000);\nconst sources = [...impressum, ...news].map(r => r.url);\n\nreturn {\n  json: {\n    ...base,\n    research_text: researchText,\n    research_sources: sources.join(' ; '),\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
